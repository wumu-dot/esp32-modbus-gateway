#
# Default configuration options (based on official mb_serial_master sdkconfig.defaults)
#
CONFIG_MB_COMM_MODE_ASCII=n
CONFIG_MB_COMM_MODE_RTU=y
CONFIG_MB_UART_BAUD_RATE=115200
CONFIG_FMB_TIMER_USE_ISR_DISPATCH_METHOD=y
CONFIG_FMB_MASTER_DELAY_MS_CONVERT=200
CONFIG_FMB_MASTER_TIMEOUT_MS_RESPOND=1000
CONFIG_LOG_DEFAULT_LEVEL_DEBUG=n
CONFIG_LOG_MAXIMUM_LEVEL_DEBUG=y

#
# ESP-MQTT: publish discarded if disconnected (GW-05, no queue buildup)
#
CONFIG_MQTT_SKIP_PUBLISH_IF_DISCONNECTED=y

#
# FEAT-ESPGW-02: WiFi + MQTT (passwords set in sdkconfig at flash time)
#
# CONFIG_MB_WIFI_SSID="SET_VIA_MENUCONFIG"
# CONFIG_MB_WIFI_PASS=""
# CONFIG_MB_MQTT_BROKER_URI="mqtt://192.168.4.1:1883"
# CONFIG_MB_MQTT_TOPIC="esp32gw/sounddog/holding"

#
# FEAT-ESPGW-04: 堆/栈诊断（诊断期【临时】，抓到第一现场后必须关掉）
#   对位 §6bg：block_trim_free = TLSF 堆损坏；COMPREHENSIVE 会在释放后填 0xFE，
#   把「写已释放内存」变成可读的 CORRUPT HEAP: Expected 0xfefefefe（官方 #135 日志同形）。
#   ⚠️ 稳态联调请改回：POISONING_DISABLED=y / TRACING_OFF=y / WATCHPOINT=n
#
CONFIG_HEAP_POISONING_DISABLED=n
CONFIG_HEAP_POISONING_COMPREHENSIVE=y
CONFIG_HEAP_TRACING_OFF=n
CONFIG_HEAP_TRACING_STANDALONE=y
CONFIG_FREERTOS_WATCHPOINT_END_OF_STACK=y

#
# FEAT-ESPGW-03: Target = ESP32-S3 N16R8 (16MB Flash + 8MB Octal PSRAM)
#
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_TYPE_AUTO=y
CONFIG_SPIRAM_SPEED_80M=y